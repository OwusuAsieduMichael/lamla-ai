# LAMLA AI environment template
# Copy this file to .env.local for local development.
# Never commit .env.local or any file that contains real secrets.

# -----------------------------------------------------------------------------
# Public (safe to expose to the browser)
# These are used by the Supabase browser and server clients.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Server-only — never prefix these with NEXT_PUBLIC_
# Do not import these from Client Components or any browser bundle.
# Leave unset until the matching Phase needs them.
# -----------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# AI_PROVIDER=openai
